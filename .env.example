# AI Coding 后端环境变量模板
# 复制为 .env 并按需修改；.env 已被 .gitignore 排除，绝不提交

# ===== MySQL =====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=ai_coding
MYSQL_USER=root
MYSQL_PASSWORD=123456

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== AI 模型（DeepSeek，OpenAI 兼容协议）=====
# 注册 https://platform.deepseek.com 获取 API Key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_MODEL=deepseek-chat
# 无 Key 联调时保持 true（使用 Mock 模型）；配置 Key 后改为 false
AI_MOCK_ENABLED=true

# ===== 生成产物工作目录 =====
WORKSPACE_PATH=./tmp/workdir
